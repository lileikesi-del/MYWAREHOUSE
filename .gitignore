# Dependencies
node_modules/
.pnpm-store/

# Next.js
.next/
out/

# Local data & uploads
data/
public/uploads/

# Raw source art (image-model output): the public/ build products and
# src/lib/cards/*.layers.json layouts are tracked; keep the raw sources local.
assets-src/

# Local notes and design specs: deploy.md stays tracked.
docs/*
!docs/deploy.md

# Misc
.DS_Store
*.log
__pycache__/

# TypeScript
*.tsbuildinfo

# Ryugi scratch (workspaces are recreated per spec)
.ryugi/

# Env files (template lives in .env.example)
.env*
!.env.example

# Deploy config. Upstream keeps this out of git because each person fills in
# their own database_id. Here it is tracked on purpose: Cloudflare's Git
# integration reads bindings from the repo at build time.

# Cloudflare build output
.open-next/
.wrangler/
